# Copy to .env.local for development. Do not commit real secrets.

# ---------------------------------------------------------------------------
# Database
# Required in production. Optional for local development.
# Without DATABASE_URL, local/test runs use an in-memory store.
# Production refuses to start without this value.
# Server-only. Never expose to the client.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://vrompt:vrompt@localhost:5432/vrompt

# ---------------------------------------------------------------------------
# Clerk authentication
# Required to start interviews and access projects.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is public.
# CLERK_SECRET_KEY is server-only. Never commit real keys.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional Clerk routing. Public values only.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/start
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/start
NEXT_PUBLIC_CLERK_AFTER_SIGN_OUT_URL=/

# Required for Clerk production keys on a host you cannot CNAME, such as
# *.vercel.app. Also set this exact URL in Clerk Dashboard → Domains →
# Frontend API → Set proxy configuration. Local live-key runs can omit this;
# the app then proxies through the current origin at /__clerk.
# NEXT_PUBLIC_CLERK_PROXY_URL=https://your-app.vercel.app/__clerk

# ---------------------------------------------------------------------------
# Interviewer LLM
# Server-only. Used for the guided interview, not for generation/export.
# Prefer DashScope (Qwen) for this project. OpenAI-compatible endpoints also work.
# Without a key, local/test uses the development mock. Production requires a key.
# ---------------------------------------------------------------------------
DASHSCOPE_API_KEY=
# LLM_API_KEY=
# OPENAI_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
